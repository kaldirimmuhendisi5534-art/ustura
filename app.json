{
  "expo": {
    "name": "Ustura",
    "slug": "ustura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "ustura",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kaldirimmuhendisi.ustura"
    },
    "android": {
      "package": "com.kaldirimmuhendisi.ustura",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ustura yakınındaki berberleri göstermek için konum bilginize ihtiyaç duyuyor."
        }
      ]
    ]
  }
}
